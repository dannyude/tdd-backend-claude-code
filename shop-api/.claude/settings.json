{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command":
              "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lock_tests.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command":
              "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_on_stop.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(bash scripts/check.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push:*)"
    ]
  }
}
